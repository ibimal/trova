{
  "name": "trova-cli",
  "version": "0.1.2",
  "description": "Local keyword and semantic search for Markdown notes: a command-line tool, an HTTP API and an MCP server, on top of qmd",
  "keywords": [
    "search",
    "semantic-search",
    "markdown",
    "notes",
    "obsidian",
    "mcp",
    "cli",
    "qmd",
    "local-first"
  ],
  "license": "MIT",
  "author": "Bimal",
  "homepage": "https://github.com/ibimal/trova#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibimal/trova.git"
  },
  "bugs": {
    "url": "https://github.com/ibimal/trova/issues"
  },
  "type": "module",
  "bin": {
    "trova": "bin/trova"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p . && node build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tobilu/qmd": "2.9.0",
    "better-sqlite3": "^13.2.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "picomatch": "^4.0.7",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
