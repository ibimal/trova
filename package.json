{
  "name": "trova-cli",
  "version": "0.1.2",
  "description": "Local keyword and semantic search for Markdown notes: a command-line tool, an HTTP API and an MCP server, on top of qmd",
  "keywords": [
    "cli",
    "local-first",
    "markdown",
    "mcp",
    "notes",
    "obsidian",
    "qmd",
    "search",
    "semantic-search"
  ],
  "homepage": "https://github.com/ibimal/trova#readme",
  "bugs": {
    "url": "https://github.com/ibimal/trova/issues"
  },
  "license": "MIT",
  "author": "Bimal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibimal/trova.git"
  },
  "bin": {
    "trova": "bin/trova"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check && tsc -p .",
    "test": "vp test run",
    "format": "vp fmt",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tobilu/qmd": "2.9.0",
    "better-sqlite3": "^13.2.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "picomatch": "^4.0.7",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.6.0",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
